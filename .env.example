DISCORD_TOKEN=
OPENAI_API_KEY=
# 省略時は gpt-4o-mini。例: gpt-4o, gpt-4.1-mini（OpenAI互換プロバイダならそのモデル名）
OPENAI_MODEL=
# 省略時は https://api.openai.com/v1。OpenRouter 等は https://openrouter.ai/api/v1 など
OPENAI_BASE_URL=
API_ENDPOINT=http://yahoo-auctions-api:8080
# RQLITE_URL が設定されているときは rqlite に接続し、DB_PATH は使わない。
RQLITE_URL=
# SQLite データベースパス (省略時: data/watch.db)。RQLITE_URL 未設定時のみ使用（ローカル・開発時）。
DB_PATH=data/watch.db
# ポーリング間隔（分） (省略時: 5)
CHECK_INTERVAL_MINUTES=5
# ポーリング時の1件あたりのディレイ（ms） (省略時: 2000)
POLL_DELAY_MS=2000
