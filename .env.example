DISCORD_TOKEN=
# OpenAI 互換 API の API キー
OPENAI_API_KEY=
# OpenAI 互換 API のベース URL（省略時: https://api.openai.com/v1）
OPENAI_BASE_URL=
# Stage1/4 用（省略時: gpt-4o-mini）
OPENAI_MODEL=
# Stage2 画像解析用（省略時: gpt-4o）
OPENAI_MODEL_VISION=
# Stage3 エージェント補完用（省略時: gpt-4o）
OPENAI_MODEL_AGENT=
# 推論に使う最大画像数（省略時: 3）
OPENAI_MAX_IMAGES=3
# 1商品あたりの最大 Web 検索回数（省略時: 3）
OPENAI_MAX_SEARCH_CALLS=3
# 多段推論パイプラインのタイムアウト秒（省略時: 45）
OPENAI_PIPELINE_TIMEOUT_SEC=45
API_ENDPOINT=http://yahoo-auctions-api:8080
# rqlite のベース URL（省略時: http://localhost:4001）
RQLITE_URL=http://localhost:4001
# 空 = 全サーバー許可。カンマ区切り
ALLOWED_GUILDS=
# 空 = 全チャンネル許可。カンマ区切り
ALLOWED_CHANNELS=
# ポーリング間隔（分） (省略時: 5)
CHECK_INTERVAL_MINUTES=5
# ポーリング時の1件あたりのディレイ（ms） (省略時: 2000)
POLL_DELAY_MS=2000
