DISCORD_TOKEN=
GEMINI_API_KEY=
# Stage1/4 用（省略時: gemini-2.5-flash-lite）
GEMINI_MODEL=
# Stage2 画像解析用（省略時: gemini-2.5-flash）
GEMINI_MODEL_VISION=
# Stage3 エージェント補完用（省略時: gemini-2.5-flash）
GEMINI_MODEL_AGENT=
# 推論に使う最大画像数（省略時: 3）
GEMINI_MAX_IMAGES=3
# 1商品あたりの最大 Web 検索回数（省略時: 3）
GEMINI_MAX_SEARCH_CALLS=3
# 多段推論パイプラインのタイムアウト秒（省略時: 45）
GEMINI_PIPELINE_TIMEOUT_SEC=45
API_ENDPOINT=http://yahoo-auctions-api:8080
# RQLITE_URL が設定されているときは rqlite に接続し、DB_PATH は使わない。
RQLITE_URL=
# SQLite データベースパス (省略時: data/watch.db)。RQLITE_URL 未設定時のみ使用（ローカル・開発時）。
DB_PATH=data/watch.db
# ポーリング間隔（分） (省略時: 5)
CHECK_INTERVAL_MINUTES=5
# ポーリング時の1件あたりのディレイ（ms） (省略時: 2000)
POLL_DELAY_MS=2000
