DISCORD_TOKEN=
GEMINI_API_KEY=
# 省略時は gemini-2.5-flash-lite。例: gemini-1.5-pro, gemini-2.0-flash
GEMINI_MODEL=
API_ENDPOINT=http://yahoo-auctions-api:8080
# RQLITE_URL が設定されているときは rqlite に接続し、DB_PATH は使わない。
RQLITE_URL=
# SQLite データベースパス (省略時: data/watch.db)。RQLITE_URL 未設定時のみ使用（ローカル・開発時）。
DB_PATH=data/watch.db
# ポーリング間隔（分） (省略時: 5)
CHECK_INTERVAL_MINUTES=5
# ポーリング時の1件あたりのディレイ（ms） (省略時: 2000)
POLL_DELAY_MS=2000
