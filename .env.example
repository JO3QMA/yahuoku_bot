DISCORD_TOKEN=
GEMINI_API_KEY=
# 省略時は gemini-1.5-flash。例: gemini-1.5-pro, gemini-2.0-flash
GEMINI_MODEL=
API_ENDPOINT=http://yahoo-auctions-api:8080
# SQLiteデータベースパス (省略時: data/watch.db)
DB_PATH=data/watch.db
# ポーリング間隔（分） (省略時: 5)
CHECK_INTERVAL_MINUTES=5
# ポーリング時の1件あたりのディレイ（ms） (省略時: 2000)
POLL_DELAY_MS=2000
